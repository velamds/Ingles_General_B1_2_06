{"_data": [{"contents": [{"content": "Vanessa Works the Evening Shift", "type": "lesson_name"}, {"content": "Oh, It's You!", "type": "unit_name"}, {"content": 10, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 6, "type": "lesson"}, {"content": "B1.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": " Identify and describe events in the news in a range of social and work contexts.", "type": "primary"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology.", "type": "secondary_1"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology.", "type": "secondary_2"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology.", "type": "secondary_3"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology.", "type": "secondary_4"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology.", "type": "secondary_5"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology.", "type": "secondary_6"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology.", "type": "secondary_7"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology.", "type": "secondary_8"}], "type": "objectives"}, {"content": "engenn7le06ob10re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "to close up", "type": "name"}, {"content": "to close a business for the day; to stop operation", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: There are still a few customers, but I'm going to close up the restaurant at 11 p.m. ", "type": "example"}, {"content": "engenn7le06ob10aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " These are words you use when you talk on the phone.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "What's going on?", "type": "name"}, {"content": " a casual way to ask what's happening or \u201cHow are you?\u201d", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Hi, Sally. Nice to hear from you. What's going on?", "type": "example"}, {"content": "engenn7le06ob10aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to pass out", "type": "name"}, {"content": "to faint or lose consciousness", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I'm so tired. I'll pass out if I stay up any longer.", "type": "example"}, {"content": "engenn7le06ob10aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to go away", "type": "name"}, {"content": " to go out of the city on vacation", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: If I went away tomorrow, I would lie on the beach for a week.", "type": "example"}, {"content": "engenn7le06ob10aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to put up with", "type": "name"}, {"content": "to endure or accept a certain mental or physical condition", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Your body can only put up with so much stress.", "type": "example"}, {"content": "engenn7le06ob10aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to break down ", "type": "name"}, {"content": "to stop functioning normally", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Sooner or later, your body is going to break down from all the stress.", "type": "example"}, {"content": "engenn7le06ob10aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to turn in ", "type": "name"}, {"content": "to go to bed", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I'm tired, so I'm going to turn in for the night.", "type": "example"}, {"content": "engenn7le06ob10aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " Phrasal Verbs", "type": "heading"}, {"content": " There are various phrasal verbs that are used to talk about different things. ", "type": "describer"}, {"content": "Phrasal verbs are constructed with:<br/>verb + particle/preposition<br/>The verb by itself has one meaning and takes on a different meaning when put together with the preposition.<br/><br/>Here is a list of phrasal verbs for talking on the phone and one list for talking about health.", "type": "text"}, {"content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Phrasal Verb for Talking on the Phone\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" to put through\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Could you put me through to the manager?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" to hold on\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Please hold on for a moment. I'll see if the manager is available.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" to hold on\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Can you speak up? I can't hear you very well.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "{\"rows\":7,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Phrasal Verb for Talking about Health\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" to pass out\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I'm so tired that I will pass out if I stay up any longer.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" to knock out\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Since I'm so tired, alcohol would knock me out completely.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" to go away\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" You'll rest your mind if you go away on vacation for a week.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" to put up with\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Your body can only put up with a limited amount of stress.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" to break down\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" If you don't get some rest, your body is going to break down.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" to turn in\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Maybe you should turn in early and get a good sleep.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": " Conditional Sentences with If Clauses", "type": "heading"}, {"content": "With conditional sentences using <span class=\"italic\">if</span> clauses, one part is the condition and the other part is the result.<br/>Two types of conditional sentences talk about imaginary situations in the future: the first and the second conditional.", "type": "describer"}, {"content": " Each conditional form uses a different verb form.", "type": "text"}, {"content": "{\"rows\":3,\"columns\":4,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Type of Conditional\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Explanation\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Structure\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" First Conditional\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" You're talking about the future. There is a real possibility that this condition will happen.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" If + condition in Present Simple, will + base verb\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class=\\\"italic\\\"> <ul><li>If you want to go out, I could meet you.</li> <li>I'll pass out if I stay up any longer.</li> <li>If I drink alcohol, it will knock me out completely.</li></ul></span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Second Conditional\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You're still talking about the future. However, there is <span class=\\\"italic\\\">not</span> a real possibility the condition will happen.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" If + condition in Past Simple, would + base verb\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"><ul><li>If we had a bed on rollers, we could roll you home from the pub.</li> <li>If I went away tomorrow, I would lie on the beach for a week.</li></ul></span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "Write a dialogue about plans you make with a friend after work. You want to go out but you don't want to stay out late.", "type": "text"}, {"content": "Use phrasal verbs related to health.", "type": "text"}, {"content": "Use conditional sentences.", "type": "text"}, {"content": "Practice the dialogue with a partner.", "type": "text"}, {"content": "Change roles.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I write a dialogue about social plans.", "type": "text"}, {"content": "I talk about staying healthy.", "type": "text"}, {"content": "I talk about wishes, conditions and results.", "type": "text"}, {"content": "I practice speaking smoothly.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn7le06ob10re2img01.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn7le06ob10re2img01.jpg", "time": "100", "id": 1, "text": "<span class=\"strong\">Helen</span>: Hello, Bistro 88. Can I help you?<br/>\n<span class=\"strong\">Sally</span>: Hi. Could you put me through to the manager please?<br/>\n<span class=\"strong\">Helen</span>: I'm sorry, but we're closed. She's occupied at the moment.<br/>\n<span class=\"strong\">Sally</span>: Sorry. Can you speak up? Please tell her it's <span class=\"italic\">Cambridge Life</span> magazine calling.<br/>\n<span class=\"strong\">Helen</span>: Sure. Hold on a moment, please."}, {"image": "engenn7le06ob10re2img05.jpg", "time": "23000", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: Hello, this is the manager. Who's speaking?<br/>\n<span class=\"strong\">Sally</span>: Hey, Vanessa. It's Sally.<br/>\n<span class=\"strong\">Vanessa</span>: Oh, it's you! I'm closing up. What's going on?<br/>\n<span class=\"strong\">Sally</span>: I'm in the neighborhood. If you want to go out, I could meet you.<br/>\n<span class=\"strong\">Vanessa</span>: Oh, Sally. I'm so tired. I'll pass out if I stay up any longer. If I drink alcohol, it will just knock me out completely.<br/>\n<span class=\"strong\">Sally</span>: Oh, Vanessa. If we had a bed on rollers, we could roll you home after."}, {"image": "engenn7le06ob10re2img02.jpg", "time": "51000", "id": 3, "text": "<span class=\"strong\">Vanessa</span>: What I need is a vacation. If I went away tomorrow, I would lie on the beach for a week.<br/>\n<span class=\"strong\">Sally</span>: Your body can only put up with so much stress. Sooner or later, it's going to break down. You wouldn't want that to happen.<br/>\n<span class=\"strong\">Vanessa</span>: No, I wouldn't. So, I'd better turn in for the night. Sorry, Sally, I'm going to let you go. We'll talk soon.<br/>\n<span class=\"strong\">Sally</span>: Alright. Take care, OK?<br/>\n<span class=\"strong\">Vanessa</span>: I will. Thanks. Bye."}], "audiosrc": "engenn7le06ob10re2aud01", "coverimg": "engenn7le06ob10re2img01.jpg"}, "type": "slideshow"}], "id": 1}], "exercises": [{"template_override": 1, "_data": [{"contents": [{"content": " I can start and end a conversation on the phone. ", "type": "Learning Outcomes"}, {"content": " I can talk about staying healthy.  ", "type": "Learning Outcomes"}, {"content": " I can talk about wishes and imaginary situations.  ", "type": "Learning Outcomes"}, {"content": " What do you do after work or school to rest your mind?", "type": "Free Header Item"}, {"content": " Do you go out with friends? Where do you go?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "allowed_attempts": 2}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": " D