ct!"}}, {"contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Speaking"}, {"type": "skill", "content": "Writing"}], "type": "learning_skills"}, {"contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self Assessment."}], "type": "post_instructions"}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "stimuli": [{"contents": [{}], "type": "welcome", "_data": [], "id": 0, "template_override": 1}, {"contents": [{"type": "slideshow", "value": {"audiosrc": "engenn7le06ob09re2aud01", "images": [{"time": "0", "text": "", "id": 0, "image": "engenn7le06ob09re2img05.jpg"}, {"time": "100", "text": "<span class=\"strong\">Mr. Curtis</span>: Hello, Vanessa.<br/>\n<span class=\"strong\">Vanessa</span>: Hello, Mr. Curtis. Nice to hear from you.<br/>\n<span class=\"strong\">Mr. Curtis</span> How are you doing?<br/>\n<span class=\"strong\">Vanessa</span>: I'm hanging in there. The dinner crowd is thinning out now. I'm a little flustered today because I've been on the phone so much with different people on top of managing the staff.", "id": 1, "image": "engenn7le06ob09re2img05.jpg"}, {"time": "17000", "text": "<span class=\"strong\">Mr. Curtis</span>: And here you are with another phone call, but that's all part of the job of a manager. We don't have to talk long. When I keep conversations short, employees can get back to work more quickly!<br/>\n<span class=\"strong\">Vanessa</span>: Yes, that's true.<br/>\n<span class=\"strong\">Mr. Curtis</span>: Make sure you get some rest in your off-hours to stay healthy. If you are stressed all the time, you burn out eventually.<br/>\n<span class=\"strong\">Vanessa</span>: If we could have the hostess answer all the phone calls, that would help me focus on my job. I'll try that out.", "id": 2, "image": "engenn7le06ob09re2img02.jpg"}, {"time": "48000", "text": "<span class=\"strong\">Mr. Curtis</span>: In the meantime, don't give up. Are you closing up soon?<br/>\n<span class=\"strong\">Vanessa</span>: Yes. There are a few customers hanging around, but I'm shutting down the cash register.<br/>\n<span class=\"strong\">Mr. Curtis</span>: Sounds good. If you wrap up soon, you'll get to bed earlier.<br/>\n<span class=\"strong\">Vanessa</span>: That's true. If I sleep in tomorrow, I'll be fresh for the evening shift.<br/>\n<span class=\"strong\">Mr. Curtis</span>: OK. Take care, Vanessa. We'll connect tomorrow.<br/>\n<span class=\"strong\">Vanessa</span>: Right. Thanks for calling, Mr. Curtis.\n<br/><span class=\"strong\">Mr. Curtis</span>: Have a good night.\n<br/><span class=\"strong\">Vanessa</span>: You too, sir.", "id": 3, "image": "engenn7le06ob09re2img05.jpg"}], "coverimg": "engenn7le06ob09re2img05.jpg"}}], "template_override": 1, "type": "audio", "_data": [], "id": 1, "title": ""}], "id": 0}]}