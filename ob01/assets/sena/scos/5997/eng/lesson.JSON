ontent": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn7le06ob01re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Write a short phone conversation that talks about work.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn7le06ob01re2img05.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>: Hi, Dad. How are you doing? <br/>\n<span class=\"strong\">Dad</span>: Oh, Vanessa. Am I looking at you live?  <br/>\n<span class=\"strong\">Vanessa</span>: Yes, Dad. It's nice to see your face.  <br/>\n<span class=\"strong\">Dad</span>: This computer video thing is neat. I'm not up with all this new technology stuff in my job. <br/>\n<span class=\"strong\">Vanessa</span>: It's called video chatting. We can use Internet data to transmit video on a laptop now. So ... you look pretty well.", "id": 1, "time": "100", "image": "engenn7le06ob01re2img05.jpg"}, {"text": "<span class=\"strong\">Dad</span>: Oh, thanks. Well, I feel up for going back to work actually. How is your job, Vanessa? <br/>\n<span class=\"strong\">Vanessa</span>: Well, there's been a lot of pressure managing the staff, but I'm keeping up with it.\nDad, if you go home, a nurse could come over and look in on you once a week.", "id": 2, "time": "27000", "image": "engenn7le06ob01re2img01.jpg"}, {"text": "<span class=\"strong\">Lily</span>: Then you'd be able to take walks at the park, George. <br/>\n<span class=\"strong\">Vanessa</span>: Listen, I have to get back to work in a bit. You should also ask the home nurse to prescribe a healthy diet, OK? <br/>\n<span class=\"strong\">Dad</span>: I'd better call up my boss. <br/>\n<span class=\"strong\">Lily</span>: Oh, George, you ought to take it easy for a while. <br/>\n<span class=\"strong\">Vanessa</span>: I'm sorry, but I have to go. Let's set up another call again. It's free. <br/>\n<span class=\"strong\">Lily</span>: You take care of yourself, sweetie. <br/>\n<span class=\"strong\">Vanessa</span>: You, too. I'll see you both soon. Bye.", "id": 3, "time": "45000", "image": "engenn7le06ob01re2img05.jpg"}], "audiosrc": "engenn7le06ob01re2aud01", "coverimg": "engenn7le06ob01re2img05.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}, {"id": 2, "title": "", "contents": [{"value": "<span class=\"strong\">Vanessa</span>: Hi, Dad. How are you doing? <br/>\n<span class=\"strong\">Dad</span>: Oh, Vanessa. Am I looking at you live?  <br/>\n<span class=\"strong\">Vanessa</span>: Yes, Dad. It's nice to see your face.  <br/>\n<span class=\"strong\">Dad</span>: This computer video thing is neat. I'm not up with all this new technology stuff in my job. <br/>\n<span class=\"strong\">Vanessa</span>: It's called video chatting. We can use Internet data to transmit video on a laptop now. So ... you look pretty well.<br/>\n<span class=\"strong\">Dad</span>: Oh, thanks. Well, I feel up for going back to work actually. How is your job, Vanessa? <br/>\n<span class=\"strong\">Vanessa</span>: Well, there's been a lot of pressure managing the staff, but I'm keeping up with it.\nDad, if you go home, a nurse could come over and look in on you once a week.<br/>\n<span class=\"strong\">Lily</span>: Then you'd be able to take walks at the park, George. <br/>\n<span class=\"strong\">Vanessa</span>: Listen, I have to get back to work in a bit. You should also ask the home nurse to prescribe a healthy diet, OK? <br/>\n<span class=\"strong\">Dad</span>: I'd better call up my boss. <br/>\n<span class=\"strong\">Lily</span>: Oh, George, you ought to take it easy for a while. <br/>\n<span class=\"strong\">Vanessa</span>: I'm sorry, but I have to go. Let's set up another call again. It's free. <br/>\n<span class=\"strong\">Lily</span>: You take care of yourself, sweetie. <br/>\n<span class=\"strong\">Vanessa</span>: You, too. I'll see you both soon. Bye.", "type": "p"}], "_data": [], "type": "text", "template_override": 1}]}]}